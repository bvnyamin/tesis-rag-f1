  "cards": [
    {
      "dot": "cyan",
      "title": "Despues de NL2SQL",
      "items": [
        "NL2SQL usa el LLM para obtener una SQL candidata.",
        "La validacion ocurre antes de consultar PostgreSQL.",
        "PostgreSQL solo ejecuta el SELECT validado."
      ]
    },
    {
      "dot": "emerald",
      "title": "RAG y embeddings",
      "items": [
        "Primero se genera el embedding de la pregunta.",
        "Chroma usa ese vector para traer chunks relevantes.",
        "Los chunks ayudan a NL2SQL y a la respuesta final."
      ]
    },
    {
      "dot": "violet",
      "title": "Respuesta con LLM",
      "items": [
        "PostgreSQL entrega datos, no redacta la respuesta.",
        "La respuesta final llama al LLM con filas reales y contexto RAG.",
        "Streamlit muestra la evidencia junto a la respuesta."
      ]
    }
  ]
